{
  "name": "@mwmdeadpool/memos-openclaw-plugin",
  "version": "0.2.0",
  "description": "OpenClaw lifecycle plugin for self-hosted MemOS (add + recall memory). Forked from @memtensor/memos-cloud-openclaw-plugin.",
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "version": "npm run sync-version && git add openclaw.plugin.json moltbot.plugin.json clawdbot.plugin.json",
    "publish-beta": "npm publish --tag beta",
    "publish-beta-patch": "npm version prepatch --preid=beta && npm publish --tag beta",
    "publish-latest": "npm version $(node -p \"require('./package.json').version.split('-')[0]\") && npm publish",
    "publish-latest-patch": "npm version patch && npm publish"
  },
  "keywords": [
    "memos",
    "memos-cloud",
    "openclaw",
    "plugin",
    "memory"
  ],
  "homepage": "https://github.com/mwmdeadpool/MemOS-Cloud-OpenClaw-Plugin#readme",
  "bugs": {
    "url": "https://github.com/mwmdeadpool/MemOS-Cloud-OpenClaw-Plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwmdeadpool/MemOS-Cloud-OpenClaw-Plugin.git"
  },
  "type": "module",
  "author": "MemTensor",
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "clawdbot": {
    "extensions": [
      "./index.js"
    ]
  },
  "moltbot": {
    "extensions": [
      "./index.js"
    ]
  }
}
